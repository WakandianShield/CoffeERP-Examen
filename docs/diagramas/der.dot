digraph G {graph [bgcolor="white",pad="0.22",nodesep="0.32",ranksep="0.48",fontname="Arial"];node [shape=box,fontname="Arial",fontsize=12,color="#444444",penwidth=1.1,style="rounded",margin="0.24,0.15"];edge [fontname="Arial",fontsize=10,color="#555555",arrowsize=.7];rankdir=LR;node [fontsize=10];users [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>email UNIQUE<BR ALIGN="LEFT"/>password_hash<BR ALIGN="LEFT"/>role<BR ALIGN="LEFT"/>active<BR ALIGN="LEFT"/></TD></TR></TABLE>>];products [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>products</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name<BR ALIGN="LEFT"/>price_cents<BR ALIGN="LEFT"/>stock / reserved<BR ALIGN="LEFT"/>minimum / active<BR ALIGN="LEFT"/></TD></TR></TABLE>>];suppliers [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>suppliers</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name<BR ALIGN="LEFT"/>email / phone<BR ALIGN="LEFT"/></TD></TR></TABLE>>];purchases [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>purchases</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK supplier_id<BR ALIGN="LEFT"/>total_cents<BR ALIGN="LEFT"/>created_at<BR ALIGN="LEFT"/></TD></TR></TABLE>>];purchase_items [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>purchase_items</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK purchase_id<BR ALIGN="LEFT"/>PK/FK product_id<BR ALIGN="LEFT"/>quantity<BR ALIGN="LEFT"/>cost_cents<BR ALIGN="LEFT"/></TD></TR></TABLE>>];sales [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>sales</B></TD></TR><TR><TD ALIGN="LEFT">PK id UUID<BR ALIGN="LEFT"/>FK user_id<BR ALIGN="LEFT"/>customer / email<BR ALIGN="LEFT"/>total_cents / status<BR ALIGN="LEFT"/>paypal_id UNIQUE<BR ALIGN="LEFT"/>capture_id UNIQUE<BR ALIGN="LEFT"/>email_status<BR ALIGN="LEFT"/></TD></TR></TABLE>>];sale_items [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>sale_items</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK sale_id<BR ALIGN="LEFT"/>PK/FK product_id<BR ALIGN="LEFT"/>name histórico<BR ALIGN="LEFT"/>quantity<BR ALIGN="LEFT"/>price_cents histórico<BR ALIGN="LEFT"/></TD></TR></TABLE>>];stock_movements [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>stock_movements</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK product_id<BR ALIGN="LEFT"/>quantity<BR ALIGN="LEFT"/>reason / created_at<BR ALIGN="LEFT"/></TD></TR></TABLE>>];employees [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name / position<BR ALIGN="LEFT"/>email<BR ALIGN="LEFT"/>salary_cents / active<BR ALIGN="LEFT"/></TD></TR></TABLE>>];payroll [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>payroll</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK employee_id<BR ALIGN="LEFT"/>period<BR ALIGN="LEFT"/>amount_cents<BR ALIGN="LEFT"/>UNIQUE(employee_id,period)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];ledger [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>ledger</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>kind / concept<BR ALIGN="LEFT"/>amount_cents<BR ALIGN="LEFT"/>reference UNIQUE<BR ALIGN="LEFT"/>created_at<BR ALIGN="LEFT"/></TD></TR></TABLE>>];users->sales [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];sales->sale_items [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];products->sale_items [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];products->stock_movements [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];suppliers->purchases [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];purchases->purchase_items [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];products->purchase_items [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];employees->payroll [label="1 : N",arrowhead=crow,arrowtail=tee,dir=both];sales->ledger [style=dashed,label="reference: sale:UUID"];purchases->ledger [style=dashed,label="reference: purchase:id"];payroll->ledger [style=dashed,label="reference: payroll:id"];}