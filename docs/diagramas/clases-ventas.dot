digraph G {graph [bgcolor="white",pad="0.22",nodesep="0.32",ranksep="0.48",fontname="Arial"];node [shape=box,fontname="Arial",fontsize=12,color="#444444",penwidth=1.1,style="rounded",margin="0.24,0.15"];edge [fontname="Arial",fontsize=10,color="#555555",arrowsize=.7];rankdir=TB;n0 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Sales</B></TD></TR><TR><TD ALIGN="LEFT">cart: Signal<BR ALIGN="LEFT"/>products: Signal<BR ALIGN="LEFT"/>pendingId: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">cash()<BR ALIGN="LEFT"/>pay()<BR ALIGN="LEFT"/>verify()<BR ALIGN="LEFT"/>xml()<BR ALIGN="LEFT"/>send()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n1 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Venta</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID<BR ALIGN="LEFT"/>user_id: int<BR ALIGN="LEFT"/>total_cents: int<BR ALIGN="LEFT"/>status: enum<BR ALIGN="LEFT"/>paypal_id: string?<BR ALIGN="LEFT"/>capture_id: string?<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n2 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>DetalleVenta</B></TD></TR><TR><TD ALIGN="LEFT">product_id: int<BR ALIGN="LEFT"/>name: string histórico<BR ALIGN="LEFT"/>quantity: int<BR ALIGN="LEFT"/>price_cents: int histórico<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n3 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>PaypalService</B></TD></TR><TR><TD ALIGN="LEFT">setup()<BR ALIGN="LEFT"/>create()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n0->n1 [label="usa / gestiona"];n1->n2 [label="relación de dominio"];n0->n3 [style=dashed,label="usa"];}