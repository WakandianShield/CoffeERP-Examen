digraph G {graph [bgcolor="white",pad="0.22",nodesep="0.32",ranksep="0.48",fontname="Arial"];node [shape=box,fontname="Arial",fontsize=12,color="#444444",penwidth=1.1,style="rounded",margin="0.24,0.15"];edge [fontname="Arial",fontsize=10,color="#555555",arrowsize=.7];rankdir=TB;n0 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Finance</B></TD></TR><TR><TD ALIGN="LEFT">data: Signal<BR ALIGN="LEFT"/>entry: tipo/concepto<BR ALIGN="LEFT"/>amount: number<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">load()<BR ALIGN="LEFT"/>save()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n1 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>ApiService</B></TD></TR><TR><TD ALIGN="LEFT">http: HttpClient<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">get()<BR ALIGN="LEFT"/>post()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n2 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>MovimientoContable</B></TD></TR><TR><TD ALIGN="LEFT">id: int<BR ALIGN="LEFT"/>kind: INGRESO|EGRESO<BR ALIGN="LEFT"/>amount_cents: int<BR ALIGN="LEFT"/>reference: string?<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n0->n1 [label="usa / gestiona"];n1->n2 [label="relación de dominio"];}