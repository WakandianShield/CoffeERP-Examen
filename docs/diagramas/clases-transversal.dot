digraph G {graph [bgcolor="white",pad="0.22",nodesep="0.32",ranksep="0.48",fontname="Arial"];node [shape=box,fontname="Arial",fontsize=12,color="#444444",penwidth=1.1,style="rounded",margin="0.24,0.15"];edge [fontname="Arial",fontsize=10,color="#555555",arrowsize=.7];rankdir=TB;n0 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Login</B></TD></TR><TR><TD ALIGN="LEFT">submit()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n1 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>AuthService</B></TD></TR><TR><TD ALIGN="LEFT">user: Signal<BR ALIGN="LEFT"/>token: Signal<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">login()<BR ALIGN="LEFT"/>restore()<BR ALIGN="LEFT"/>logout()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n2 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT">id: int<BR ALIGN="LEFT"/>email: string<BR ALIGN="LEFT"/>password_hash: string<BR ALIGN="LEFT"/>role: ADMIN|CAJERO<BR ALIGN="LEFT"/>active: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n3 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Shell</B></TD></TR><TR><TD ALIGN="LEFT">logout()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n0->n1 [label="usa / gestiona"];n1->n2 [label="relación de dominio"];n0->n3 [style=dashed,label="usa"];}