digraph G {graph [bgcolor="white",pad="0.22",nodesep="0.32",ranksep="0.48",fontname="Arial"];node [shape=box,fontname="Arial",fontsize=12,color="#444444",penwidth=1.1,style="rounded",margin="0.24,0.15"];edge [fontname="Arial",fontsize=10,color="#555555",arrowsize=.7];n0 [label="Inicio → Abrir Compras",shape=box];n1 [label="Validar sesión y rol ADMIN",shape=box];n2 [label="Seleccionar proveedor y producto",shape=box];n3 [label="¿Datos válidos?",shape=diamond];n4 [label="Calcular costo por cantidad",shape=box];n5 [label="Iniciar transacción SQL",shape=box];n6 [label="Guardar compra, entrada y egreso",shape=box];n7 [label="Confirmar recepción y actualizar stock",shape=box];n0->n1->n2->n3;n3->n4 [label="Sí"];n4->n5->n6->n7;end [label="Fin",shape=oval];n3->err [label="No"];err [label="Mostrar error sin guardar"];err->n2;n7->end;}