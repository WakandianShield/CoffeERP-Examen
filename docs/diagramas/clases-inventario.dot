digraph G {graph [bgcolor="white",pad="0.22",nodesep="0.32",ranksep="0.48",fontname="Arial"];node [shape=box,fontname="Arial",fontsize=12,color="#444444",penwidth=1.1,style="rounded",margin="0.24,0.15"];edge [fontname="Arial",fontsize=10,color="#555555",arrowsize=.7];rankdir=TB;n0 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Inventory</B></TD></TR><TR><TD ALIGN="LEFT">products: Signal<BR ALIGN="LEFT"/>movements: Signal<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">save()<BR ALIGN="LEFT"/>edit()<BR ALIGN="LEFT"/>adjust()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n1 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>Producto</B></TD></TR><TR><TD ALIGN="LEFT">id: int<BR ALIGN="LEFT"/>name: string<BR ALIGN="LEFT"/>price_cents: int<BR ALIGN="LEFT"/>stock: int<BR ALIGN="LEFT"/>reserved: int<BR ALIGN="LEFT"/>minimum: int<BR ALIGN="LEFT"/>active: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n2 [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14"><TR><TD BGCOLOR="#ededed"><B>MovimientoInventario</B></TD></TR><TR><TD ALIGN="LEFT">id: int<BR ALIGN="LEFT"/>product_id: int<BR ALIGN="LEFT"/>quantity: int<BR ALIGN="LEFT"/>reason: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];n0->n1 [label="usa / gestiona"];n1->n2 [label="relación de dominio"];}